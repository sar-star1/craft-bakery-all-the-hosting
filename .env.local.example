# Supabase project that hosts the shared `orders` table (see supabase/schema.sql).
# This is a separate project from the two Lovable site projects — it's the
# unified store the admin dashboard reads/writes.

SUPABASE_URL=https://your-project.supabase.co

# Service role key — server-only, never exposed to the browser. Used by
# lib/supabase/server.ts and app/actions.ts so the dashboard can work without
# a login system for v1. Find it in Supabase: Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Standard Telegram bot (BotFather) — used for the agent, admin
# notifications, and sending approved pending_replies. Never exposed to the
# browser; only used from lib/telegram.ts on the server.
TELEGRAM_BOT_TOKEN=123456:your-bot-token
# Bot's @username (no @), used to build migration deep links (t.me/<username>?start=...).
TELEGRAM_BOT_USERNAME=your_bot_username
# Chat ID of the separate admin notification group.
TELEGRAM_ADMIN_GROUP_ID=-1001234567890

# Used by the agent loop (lib/agent) to call Claude for conversation
# handling. Get one at https://console.anthropic.com — this is separate
# from whatever environment is used to develop this app.
ANTHROPIC_API_KEY=your-anthropic-api-key
